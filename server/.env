NODE_ENV=development
PORT=5000
APP_NAME=BattleZone Esports

# MongoDB Atlas connection string (create a database user + allow your IP in Atlas > Network Access)

MONGODB_URI=mongodb+srv://jawagarshanmuganathan_db_user:gaming1234@cluster0.bn3dsft.mongodb.net/
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=Jawahar_secret_key
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Use 'lax' when client and API share a site; 'none' (HTTPS only) when they are on different sites
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (1 on Render/Heroku/Nginx)
TRUST_PROXY=0

DEFAULT_TIMEZONE=Asia/Kolkata
REQUIRE_EMAIL_VERIFICATION=false
REGISTRATION_HOLD_MINUTES=15
PLATFORM_FEE_PERCENT=0
TAX_PERCENT=0

# Razorpay TEST keys (Dashboard > Settings > API Keys, Test mode)
RAZORPAY_KEY_ID=rzp_test_TpSOdTprLfP7W0
RAZORPAY_KEY_SECRET=V7Pat4hQRr7PF5nnG9vDm6NA
# Dashboard > Settings > Webhooks. URL: https://<api-host>/api/v1/payments/webhook
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Required in production for the scheduler (BullMQ). Leave empty in development.
REDIS_URL=
SCHEDULER_INTERVAL_SECONDS=30

# Email (leave SMTP_HOST empty in development: links are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=jawagar100@gmail.com

# Only used by npm run seed
SEED_ADMIN_EMAIL=vickeysujith22b@gmail.com
SEED_ADMIN_PASSWORD=Vickeysujith@12345